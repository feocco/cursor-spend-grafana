    {
      "id": 8,
      "type": "table",
      "title": "Spend per person",
      "description": "Human users only. Automations that run as a person are included in that person's spend.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "spend-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(nullif(m.name, ''), e.user_email) AS \"Person\", e.user_email AS \"Email\",\n       round(sum(e.charged_cents) / 100, 2) AS \"USD\",\n       round(sum(e.charged_cents) FILTER (WHERE e.cloud_agent_id IS NOT NULL) / 100, 2) AS \"Cloud agent USD\",\n       count(*) AS \"Events\"\nFROM usage_events e LEFT JOIN members m ON m.email = e.user_email\nWHERE $__timeFilter(e.ts) AND e.service_account_id IS NULL\nGROUP BY 1, 2 ORDER BY 3 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*USD$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "USD",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Spend per team group",
      "description": "Team groups from /teams/directory-groups (SCIM-synced or created in the dashboard), with today's membership. Someone in two groups counts in both, so the column can sum to more than total spend.",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "spend-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT g.name AS \"Group\", count(gm.email) AS \"Members\", round(coalesce(sum(s.usd), 0), 2) AS \"USD\"\nFROM directory_groups g LEFT JOIN directory_group_members gm ON gm.group_id = g.id\nLEFT JOIN (SELECT user_email, sum(charged_cents) / 100 AS usd FROM usage_events WHERE $__timeFilter(ts) AND service_account_id IS NULL GROUP BY 1) s ON s.user_email = gm.email\nGROUP BY g.id, g.name ORDER BY 3 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "noValue": "No team groups on this team"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*USD$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "USD",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Spend per service account",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 27,
