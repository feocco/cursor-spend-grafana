        "y": 27,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "spend-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT automation_id AS \"Automation\", coalesce(max(service_account_name), 'runs as ' || max(user_email)) AS \"Runs as\",\n       round(sum(charged_cents) / 100, 2) AS \"USD\", count(DISTINCT cloud_agent_id) AS \"Cloud agent runs\", count(*) AS \"Events\"\nFROM usage_events WHERE $__timeFilter(ts) AND automation_id IS NOT NULL\nGROUP BY 1 ORDER BY 3 DESC"
