    {
      "id": 12,
      "type": "table",
      "title": "Bugbot reviews by repo (Analytics API)",
      "description": "From /analytics/team/bugbot-reviews. cost_cents is list cost; only billed reviews reach the invoice.",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "spend-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT repo AS \"Repo\", count(*) AS \"Reviews\", count(*) FILTER (WHERE billed) AS \"Billed reviews\",\n       round(coalesce(sum(cost_cents), 0) / 100, 2) AS \"Cost USD\", round(coalesce(sum(cost_cents) FILTER (WHERE billed), 0) / 100, 2) AS \"Billed USD\"\nFROM bugbot_reviews WHERE $__timeFilter(ts)\nGROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": [
