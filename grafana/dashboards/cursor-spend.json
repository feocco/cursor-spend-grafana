    {
      "id": 6,
      "type": "stat",
      "title": "Data age (min)",
      "description": "Minutes since the last successful scheduled usage pass. The collector runs hourly; above ~70 means it is behind.",
      "gridPos": {
        "x": 20,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "spend-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT extract(epoch FROM now() - max(finished_at)) / 60 FROM collector_runs WHERE status = 'ok' AND job = 'usage-scheduled'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#f54e00"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Daily spend by category",
      "description": "Days start at midnight in TIMEZONE from .env.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "spend-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('day', ts) AS time, CASE\n    WHEN cloud_agent_id IS NOT NULL AND automation_id IS NOT NULL THEN 'Cloud agent: automation'\n    WHEN cloud_agent_id IS NOT NULL AND service_account_id IS NOT NULL THEN 'Cloud agent: service account'\n    WHEN cloud_agent_id IS NOT NULL THEN 'Cloud agent: person'\n    WHEN model = 'github_bugbot' OR service_account_name = 'bugbot' THEN 'Bugbot'\n    WHEN model LIKE 'grok-bot-%' THEN 'Grokbot'\n    WHEN raw->>'automationManagedType' IS NOT NULL THEN 'Managed: ' || lower(replace(raw->>'automationManagedType', '_', ' '))\n    WHEN service_account_id IS NOT NULL THEN 'Service account: non-cloud-agent'\n    ELSE 'Local agent / IDE / CLI'\n  END AS metric, sum(charged_cents) / 100 AS usd FROM usage_events WHERE $__timeFilter(ts) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^Managed: .*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#bab0ac"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Cloud agent: automation"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#f54e00"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Cloud agent: person"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#4e79a7"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Cloud agent: service account"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#edc948"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Bugbot"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#e040fb"
                }
              }
            ]
          },
          {
