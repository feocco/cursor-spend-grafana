# Required: a Team Admin API key (Cursor dashboard > Settings > API keys).
CURSOR_TEAM_ADMIN_API_KEY=
# Required: IANA time zone for day boundaries, e.g. America/Los_Angeles or Europe/London.
TIMEZONE=UTC

# Optional. The defaults are shown.
# Grafana login is admin / this password.
# GRAFANA_ADMIN_PASSWORD=admin
# How far back the first pass on an empty database reads. Use `backfill` for older history.
# INITIAL_LOOKBACK_HOURS=48
# How much before the watermark each pass re-reads, to catch late charges.
# OVERLAP_HOURS=2
# SYNC_INTERVAL_SECONDS=3600
